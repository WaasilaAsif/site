---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, fmtDate, isoDate, readingMinutes, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = (await getPosts()).filter((p) => !p.data.external);
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, tags, kind } = post.data;
---
<Base title={title} description={description} article>
  <article>
    <header class="post-head">
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={isoDate(date)}>{fmtDate(date)}</time>
        {updated && <span>updated <time datetime={isoDate(updated)}>{fmtDate(updated)}</time></span>}
        <span>{readingMinutes(post)} min read</span>
        {kind === 'notes' && <span>a note</span>}
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    {tags.length > 0 && (
      <p class="tags">Filed under {tags.join(', ')}.</p>
    )}
  </article>

  {(older || newer) && (
    <nav class="pager" aria-label="More posts">
      {older ? <a href={`/writing/${older.id}/`} rel="prev">Older: {older.data.title}</a> : <span />}
      {newer && <a href={`/writing/${newer.id}/`} rel="next">Newer: {newer.data.title}</a>}
    </nav>
  )}
</Base>

<style>
  .post-head { margin-bottom: 2.5rem; }
  .post-head h1 { max-width: 24ch; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.25rem 1.1rem; color: var(--graphite); font-size: 0.93rem; margin: 0; }
  .meta time { font-family: var(--mono); font-size: 0.86rem; }
  .tags { margin-top: 3rem; color: var(--graphite); font-size: 0.93rem; }
  .pager {
    display: flex; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap;
    margin-top: 3rem; padding-top: 1.25rem; border-top: 1px solid var(--rule); font-size: 0.95rem;
  }
</style>
