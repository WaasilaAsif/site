---
import { postHref, fmtDate, isoDate, readingMinutes, type Post } from '../lib/posts';
interface Props { posts: Post[]; showKind?: boolean }
const { posts, showKind = true } = Astro.props;
---
{posts.length === 0 ? (
  <p class="muted">Nothing here yet. The first post is being written.</p>
) : (
  <ol class="posts">
    {posts.map((p) => (
      <li>
        <time datetime={isoDate(p.data.date)}>{fmtDate(p.data.date)}</time>
        <div>
          <a href={postHref(p)}>{p.data.title}</a>
          {p.data.draft && <span class="tag draft">draft</span>}
          <p class="meta">
            {showKind && p.data.kind === 'notes' && <span class="tag">note</span>}
            {p.data.external
              ? <span>on {new URL(p.data.external).hostname.replace('www.', '')}</span>
              : <span>{readingMinutes(p)} min read</span>}
          </p>
        </div>
      </li>
    ))}
  </ol>
)}

<style>
  .posts { list-style: none; padding: 0; margin: 0; }
  .posts li {
    display: grid; grid-template-columns: 7.5rem 1fr; gap: 0 1.25rem;
    padding: 0.7rem 0; border-bottom: 1px solid var(--rule);
  }
  .posts li:first-child { border-top: 1px solid var(--rule); }
  time { font-family: var(--mono); font-size: 0.82rem; color: var(--graphite); padding-top: 0.2rem; }
  .posts a { color: var(--ink); text-decoration-color: var(--rule); font-weight: 500; }
  .posts a:hover { text-decoration-color: var(--cobalt); color: var(--cobalt); }
  .meta { margin: 0.15rem 0 0; font-size: 0.88rem; color: var(--graphite); display: flex; gap: 0.75rem; }
  .tag { font-size: 0.8rem; border: 1px solid var(--rule); border-radius: 3px; padding: 0 0.35rem; }
  .draft { margin-left: 0.5rem; background: var(--amber); color: var(--amber-ink); border-color: transparent; }
  @media (max-width: 520px) {
    .posts li { grid-template-columns: 1fr; }
    time { padding: 0 0 0.1rem; }
  }
</style>
