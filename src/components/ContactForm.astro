---
// Posts to /api/contact (worker/index.ts). Your addresses never appear in the
// page source; they live in the CONTACT_TO secret on Cloudflare.
// PUBLIC_TURNSTILE_SITE_KEY comes from .env; the fallback is Cloudflare's
// always-pass test key, so the form works in `npm run dev`.
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '1x00000000000000000000AA';
---
<form class="contact" id="contact" method="post" action="/api/contact" novalidate>
  <div class="two">
    <div>
      <label for="c-name">Name <span class="opt">(optional)</span></label>
      <input id="c-name" name="name" maxlength="80" autocomplete="name" />
    </div>
    <div>
      <label for="c-email">Email <span class="opt">(optional, so I can reply)</span></label>
      <input id="c-email" name="email" type="email" maxlength="254" autocomplete="email" />
    </div>
  </div>
  <div>
    <label for="c-message">Message</label>
    <textarea id="c-message" name="message" rows="6" maxlength="4000" required></textarea>
  </div>

  <!-- Honeypot. Hidden from people and screen readers; bots fill it in. -->
  <div class="hp" aria-hidden="true">
    <label for="c-website">Leave this empty</label>
    <input id="c-website" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <div class="cf-turnstile" data-sitekey={siteKey} data-theme="auto" data-size="flexible"></div>

  <div class="actions">
    <button type="submit" id="c-send">Send message</button>
    <p id="c-status" role="status" aria-live="polite"></p>
  </div>
</form>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  const form = document.getElementById('contact') as HTMLFormElement;
  const status = document.getElementById('c-status')!;
  const send = document.getElementById('c-send') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const message = (form.elements.namedItem('message') as HTMLTextAreaElement).value.trim();
    if (!message) {
      status.textContent = 'Write a message first.';
      status.dataset.state = 'error';
      return;
    }
    send.disabled = true;
    status.dataset.state = '';
    status.textContent = 'Sending…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const out = await res.json().catch(() => ({}));
      if (res.ok && out.ok) {
        form.reset();
        status.textContent = 'Sent. I read everything that comes in.';
        status.dataset.state = 'ok';
      } else {
        status.textContent = out.error ?? 'The message couldn’t be sent. Try again in a few minutes.';
        status.dataset.state = 'error';
      }
    } catch {
      status.textContent = 'You seem to be offline. Check your connection and send again.';
      status.dataset.state = 'error';
    } finally {
      send.disabled = false;
      (window as any).turnstile?.reset();
    }
  });
</script>

<style>
  .contact { display: grid; gap: 1rem; max-width: var(--measure); margin-top: 1rem; }
  .two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  @media (max-width: 560px) { .two { grid-template-columns: 1fr; } }
  label { display: block; font-size: 0.93rem; margin-bottom: 0.25rem; }
  .opt { color: var(--graphite); }
  input, textarea {
    width: 100%; font: inherit; color: var(--ink); background: var(--sheet);
    border: 1.5px solid var(--rule); border-radius: 6px; padding: 0.5rem 0.65rem;
  }
  textarea { resize: vertical; }
  input:focus, textarea:focus { border-color: var(--cobalt); outline: none; }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; }
  button {
    font: inherit; font-weight: 600; color: var(--amber-ink); background: var(--amber);
    border: 2px solid var(--ink); border-radius: 8px; padding: 0.45rem 1.1rem; cursor: pointer;
  }
  button:disabled { opacity: 0.6; cursor: progress; }
  #c-status { margin: 0; font-size: 0.95rem; }
  #c-status[data-state='error'] { color: var(--error); }
</style>
